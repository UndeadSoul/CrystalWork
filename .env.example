# Plantilla de variables de entorno del backend.
# Copia este archivo a .env y completa los valores. El .env NO se versiona.
# Generar una SECRET_KEY nueva:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Obligatoria en producción ---
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria

# --- Desarrollo vs producción ---
# En producción: DEBUG=False
DEBUG=True

# Hosts permitidos (separados por coma). Ej: midominio.cl,www.midominio.cl
# ALLOWED_HOSTS=
# Orígenes confiables para el admin (con esquema). Ej: https://midominio.cl
# CSRF_TRUSTED_ORIGINS=

# --- Base de datos ---
# Si se definen estas, Django usa PostgreSQL; si no, usa SQLite (desarrollo).
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
